# Identity is NOT stored here. `./install git` writes it to ~/.gitconfig.local
[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[core]
	editor = vim

# GitHub auth via gh (resolved through PATH, so it survives gh upgrades)
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
