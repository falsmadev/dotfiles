#!/usr/bin/env bash
# Dotfiles installer. Idempotent. Run in parts or all at once.
#   ./install [-n|--dry-run] <step...>
# Steps: packages | mise | link | git | pi | all
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKUP="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
DRY=0

log()  { printf '\033[36m::\033[0m %s\n' "$*"; }
ok()   { printf '\033[32m✓\033[0m  %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m  %s\n' "$*" >&2; }
die()  { printf '\033[31m✗\033[0m  %s\n' "$*" >&2; exit 1; }
run()  { if ((DRY)); then printf '   [dry-run] %s\n' "$*"; else "$@"; fi; }

# Strip comments and blank lines from a list file
list() { grep -vE '^\s*(#|$)' "$1"; }

distro() {
  [[ -r /etc/os-release ]] || { echo unknown; return; }
  . /etc/os-release
  case " $ID $ID_LIKE " in
    *" arch "*)   echo arch ;;
    *" debian "*) echo debian ;;
    *)            echo unknown ;;
  esac
}

step_packages() {
  local d; d="$(distro)"
  log "System packages ($d)"
  case "$d" in
    arch)   run sudo pacman -S --needed --noconfirm $(list "$DOTFILES/packages/arch.txt") ;;
    debian) run sudo apt-get update; run sudo apt-get install -y $(list "$DOTFILES/packages/debian.txt") ;;
    *)      warn "Unsupported distro; install packages from packages/*.txt manually"; return 0 ;;
  esac
  ok "packages done"
}

step_mise() {
  log "mise + dev tools"
  if ! command -v mise >/dev/null 2>&1 && [[ ! -x "$HOME/.local/bin/mise" ]]; then
    if [[ "$(distro)" == arch ]]; then run sudo pacman -S --needed --noconfirm mise
    else run bash -c 'curl -fsSL https://mise.run | sh'; fi
  fi
  # Config must be linked first so mise sees mise.toml
  [[ -L "$HOME/.config/mise/config.toml" ]] || warn "run './install link' first so mise.toml is in place"
  local m; m="$(command -v mise || echo "$HOME/.local/bin/mise")"
  run "$m" install -y
  ok "mise done"
}

step_link() {
  log "Linking dotfiles (backups -> $BACKUP)"
  local src dst target
  while read -r src dst; do
    [[ -z "${src:-}" || "$src" == \#* ]] && continue
    dst="${dst/#\~/$HOME}"
    target="$DOTFILES/$src"
    [[ -e "$target" ]] || { warn "missing in repo: $src"; continue; }
    if [[ -L "$dst" && "$(readlink "$dst")" == "$target" ]]; then
      echo "   = $dst (already linked)"; continue
    fi
    if [[ -e "$dst" || -L "$dst" ]]; then
      run mkdir -p "$BACKUP"
      run mv "$dst" "$BACKUP/$(echo "$dst" | tr '/' '_')"
      echo "   ~ backed up $dst"
    fi
    run mkdir -p "$(dirname "$dst")"
    run ln -s "$target" "$dst"
    echo "   + $dst -> $src"
  done < "$DOTFILES/links.txt"
  ok "links done"
}

step_git() {
  log "Git identity (stored in ~/.gitconfig.local, never committed)"
  local f="$HOME/.gitconfig.local" name email
  if git config --file "$f" user.email >/dev/null 2>&1; then
    ok "identity already set: $(git config --file "$f" user.name) <$(git config --file "$f" user.email)>"; return
  fi
  if ((DRY)); then echo "   [dry-run] would prompt for name/email"; return; fi
  read -rp "   Git name: " name; read -rp "   Git email: " email
  [[ -n "$name" && -n "$email" ]] || die "name and email are required"
  git config --file "$f" user.name "$name"
  git config --file "$f" user.email "$email"
  ok "identity written"
}

step_pi() { DOTFILES_DRY="$DRY" "$DOTFILES/adapters/pi/link"; }

steps=()
for a in "$@"; do
  case "$a" in
    -n|--dry-run) DRY=1 ;;
    -h|--help) sed -n '2,5p' "$0"; exit 0 ;;
    packages|mise|link|git|pi) steps+=("$a") ;;
    all) steps+=(packages link mise git pi) ;;
    *) die "unknown argument: $a" ;;
  esac
done
((${#steps[@]})) || { sed -n '2,5p' "$0"; exit 1; }
for s in "${steps[@]}"; do "step_$s"; done
