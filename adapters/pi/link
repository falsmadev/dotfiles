#!/usr/bin/env bash
# Wire the harness-neutral agent/ core into pi. Idempotent. DOTFILES_DRY=1 for a preview.
#   skills     -> ~/.agents/skills/<name>        (per-skill symlinks; other tools can read this path)
#   AGENTS.md  -> ~/.pi/agent/AGENTS.md          (symlink)
#   extension  -> ~/.pi/agent/extensions/subagent (symlink)
#   agents     -> ~/.pi/agent/agents/<name>.md   (rendered copies: model line added from models.conf)
#   settings   -> ~/.pi/agent/settings.json      (managed keys merged over existing; pi's own runtime keys kept)
#   mcp        -> ~/.pi/agent/mcp.json           (servers merged in + mcp-overrides.json; existing entries such as radius kept)
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PI="$HOME/.pi/agent"
BACKUP="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
DRY="${DOTFILES_DRY:-0}"
MARK="<!-- generated by dotfiles: edit agent/agents/ and adapters/pi/models.conf, then ./install pi -->"

run()  { if [[ "$DRY" == 1 ]]; then printf '   [dry-run] %s\n' "$*"; else "$@"; fi; }
log()  { printf '\033[36m::\033[0m %s\n' "$*"; }
ok()   { printf '\033[32m✓\033[0m  %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m  %s\n' "$*" >&2; }

# link <target> <dest>: symlink, backing up anything else that is in the way
link() {
  local target="$1" dest="$2"
  if [[ -L "$dest" && "$(readlink "$dest")" == "$target" ]]; then echo "   = $dest"; return; fi
  if [[ -e "$dest" || -L "$dest" ]]; then
    run mkdir -p "$BACKUP"; run mv "$dest" "$BACKUP/$(echo "$dest" | tr '/' '_')"; echo "   ~ backed up $dest"
  fi
  run mkdir -p "$(dirname "$dest")"; run ln -s "$target" "$dest"; echo "   + $dest"
}

# --- skills ---
log "Skills -> ~/.agents/skills"
for d in "$ROOT"/agent/skills/*/; do link "${d%/}" "$HOME/.agents/skills/$(basename "$d")"; done
# prune links we created for skills that have since been removed from the repo
if [[ -d "$HOME/.agents/skills" ]]; then
  for l in "$HOME"/.agents/skills/*; do
    [[ -L "$l" ]] || continue
    t="$(readlink "$l")"
    [[ "$t" == "$ROOT/agent/skills/"* && ! -e "$t" ]] && { run rm "$l"; echo "   - pruned $l"; }
  done
fi

# --- rules + extension ---
log "Rules and extension"
link "$ROOT/agent/AGENTS.md" "$PI/AGENTS.md"
link "$ROOT/adapters/pi/extensions/subagent" "$PI/extensions/subagent"

# --- agents (rendered) ---
log "Agents -> $PI/agents"
run mkdir -p "$PI/agents"
declare -A MODEL=()
while read -r name model; do
  [[ -z "${name:-}" || "$name" == \#* ]] && continue
  MODEL["$name"]="$model"
done < "$ROOT/adapters/pi/models.conf"

for f in "$ROOT"/agent/agents/*.md; do
  name="$(basename "$f" .md)"; dest="$PI/agents/$name.md"
  # Insert "model:" just before the closing frontmatter fence, then the generated marker after it
  out="$(awk -v model="${MODEL[$name]:-}" -v mark="$MARK" '
    NR==1 && $0=="---" { infm=1; print; next }
    infm && $0=="---"  { if (model!="") print "model: " model; print; print mark; infm=0; next }
    { print }' "$f")"
  if [[ -e "$dest" && ! -L "$dest" ]] && ! grep -qF "generated by dotfiles" "$dest"; then
    run mkdir -p "$BACKUP"; run mv "$dest" "$BACKUP/agents_$name.md"; echo "   ~ backed up unmanaged $dest"
  fi
  if [[ -f "$dest" && "$(cat "$dest")" == "$out" ]]; then echo "   = $dest (${MODEL[$name]:-inherit})"; continue; fi
  if [[ "$DRY" == 1 ]]; then echo "   [dry-run] render $dest (${MODEL[$name]:-inherit})"; else printf '%s\n' "$out" > "$dest"; echo "   + $dest (${MODEL[$name]:-inherit})"; fi
done
# prune generated agents no longer in the repo
for g in "$PI"/agents/*.md; do
  [[ -f "$g" ]] && grep -qF "generated by dotfiles" "$g" && [[ ! -e "$ROOT/agent/agents/$(basename "$g")" ]] \
    && { run rm "$g"; echo "   - pruned $g"; }
done

# --- settings + MCP merges (both need jq) ---
command -v jq >/dev/null || { warn "jq not installed; skipping settings and MCP merges (./install packages)"; exit 0; }

# --- settings merge ---
log "Settings -> $PI/settings.json (merge)"
scur="$PI/settings.json"
sbase="$( [[ -f "$scur" ]] && cat "$scur" || echo '{}' )"
smerged="$(jq -S --slurpfile managed "$ROOT/adapters/pi/settings.json" '. * $managed[0]' <<<"$sbase")"
if [[ -f "$scur" && "$(jq -S . "$scur")" == "$smerged" ]]; then echo "   = $scur"
else
  [[ -f "$scur" ]] && { run mkdir -p "$BACKUP"; run cp "$scur" "$BACKUP/settings.json"; echo "   ~ backed up $scur"; }
  if [[ "$DRY" == 1 ]]; then echo "   [dry-run] write merged settings.json: $(jq -r 'keys|join(", ")' <<<"$smerged")"
  else mkdir -p "$PI"; printf '%s\n' "$smerged" > "$scur"; echo "   + settings: $(jq -r 'keys|join(", ")' <<<"$smerged")"; fi
fi

# --- MCP merge ---
log "MCP servers -> $PI/mcp.json (merge)"
cur="$PI/mcp.json"
base="$( [[ -f "$cur" ]] && cat "$cur" || echo '{}' )"
# neutral servers first, then pi-only overrides (exposure) merged into the matching servers
merged="$(jq -S --slurpfile new "$ROOT/agent/mcp/servers.json" --slurpfile ov "$ROOT/adapters/pi/mcp-overrides.json" '
  .mcpServers = ((.mcpServers // {}) + $new[0].mcpServers)
  | reduce ($ov[0].mcpServers | keys[]) as $k (.; if .mcpServers[$k] then .mcpServers[$k] += $ov[0].mcpServers[$k] else . end)' <<<"$base")"
if [[ -f "$cur" && "$(jq -S . "$cur")" == "$merged" ]]; then echo "   = $cur"
else
  [[ -f "$cur" ]] && { run mkdir -p "$BACKUP"; run cp "$cur" "$BACKUP/mcp.json"; echo "   ~ backed up $cur"; }
  if [[ "$DRY" == 1 ]]; then echo "   [dry-run] write merged mcp.json: $(jq -r '.mcpServers|keys|join(", ")' <<<"$merged")"
  else mkdir -p "$PI"; printf '%s\n' "$merged" > "$cur"; echo "   + servers: $(jq -r '.mcpServers|keys|join(", ")' <<<"$merged")"; fi
fi
ok "pi adapter done. In pi, run /reload."
